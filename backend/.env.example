# Copia este archivo a backend/.env y completa los valores. NUNCA subas el .env real.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# Origen exacto desde el que se usa la app (sin barra final).
# Desarrollo: http://localhost:5173   Producción: https://zkl.zakiumy.com
ALLOWED_ORIGIN=https://zkl.zakiumy.com

# Cadena aleatoria de 32+ caracteres. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Key de Riot (developer.riotgames.com). Las de desarrollo caducan cada 24 h:
# cámbiala aquí y reinicia con `pm2 restart zkleague --update-env`.
RIOT_API_KEY=

# Límites de tu key: "peticiones:segundos,...". Dev key = 20:1,100:120
RIOT_RATE_LIMITS=20:1,100:120

# queueType(s) que se muestran como "5v5" (Ranked 5s), separados por coma.
# Si Riot usa otro nombre, aparecerá como cola extra en la tarjeta: cópialo aquí.
RIOT_QUEUE_5V5=RANKED_TEAM_5x5

# Segundos mínimos entre actualizaciones de una misma cuenta.
REFRESH_COOLDOWN_SECONDS=60

# Cada cuántas horas se actualiza sola cada cuenta, para ir guardando el
# historial de rangos aunque no abras la app. 0 = desactivado.
AUTO_REFRESH_HOURS=12

# Permitir que se registren nuevos usuarios. Créate tu cuenta y ponlo en false
# hasta que quieras abrir la app al público.
REGISTRATION_OPEN=true

SESSION_DAYS=7
DB_PATH=data/zkleague.sqlite
